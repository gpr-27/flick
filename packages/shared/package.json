{
  "name": "@chat/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Small dependency-free utilities shared by api, worker and web.",
  "type": "module",
  "exports": {
    ".": {
      "@chat/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
