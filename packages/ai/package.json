{
  "name": "@chat/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-provider LLM fallback chain (Anthropic -> Groq x2 -> Gemini x2) with cooldowns, task helpers and Fastify SSE routes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@chat/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "tsx scripts/ai-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "ioredis": "^6.0.0",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  }
}
