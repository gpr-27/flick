# Flick: environment template.  Copy to ".env":  cp .env.example .env
# Every value here is a safe local placeholder. Never commit a real .env.
# Docker Compose reads this file only when you pass it:
#   docker compose -f infra/docker/compose.yml --env-file .env up -d

# ── 1. Local stack (infra/docker/compose.yml) ────────────────
POSTGRES_PASSWORD=chat
MINIO_ROOT_PASSWORD=minioadmin-dev
S3_SECRET_ACCESS_KEY=chat-app-dev-secret
# Shared with coturn; the API signs short-lived TURN credentials with it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=dev-turn-secret
GRAFANA_ADMIN_PASSWORD=admin

# Host ports (change any that clash)
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
TURN_PORT=3478
WEB_PORT=5173
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
# Integration-test stack (compose.test.yml)
TEST_POSTGRES_PORT=55432
TEST_REDIS_PORT=56379
TEST_MINIO_PORT=59000

# Production compose (compose.prod.yml) has no defaults and refuses to start until you set these
# in a git-ignored .env.prod: POSTGRES_PASSWORD, S3_SECRET_ACCESS_KEY, MINIO_ROOT_USER,
# MINIO_ROOT_PASSWORD, TURN_SECRET, TURN_REALM, TURN_EXTERNAL_IP, TURN_URLS,
# GRAFANA_ADMIN_PASSWORD, PUBLIC_ORIGIN, S3_PUBLIC_ENDPOINT. Optional: HTTP_PORT (default 80).

# ── 2. API and worker (apps/api, apps/worker) ────────────────
# Inside compose these are set for you. When you run `npm run dev` on the host they come from here.
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
# Hosts such as Render set PORT instead; the API uses it when API_PORT is not set.
API_PORT=4000
TRUST_PROXY=false
RATE_LIMIT_MAX=300
# The web app origin: the CORS allow-list and Clerk's authorizedParties. Required in production.
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6379
WORKER_METRICS_PORT=9465

# Login (https://dashboard.clerk.com > API keys). The secret key is required by the API.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Object storage: MinIO locally. For AWS S3 leave S3_ENDPOINT empty and set only the bucket, region and keys.
# Without storage, uploads return 503.
S3_ENDPOINT=http://localhost:9000
# Address browsers use for presigned URLs (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chat-media
S3_ACCESS_KEY_ID=chat-app
S3_FORCE_PATH_STYLE=true
# Public base URL of the bucket for avatar links (needs a public bucket or a CDN). Optional.
S3_PUBLIC_URL=

# ── 3. Optional features (each is off while its keys are empty) ─
# Group calls and call links (LiveKit). 1:1 calls use TURN_SECRET and TURN_URLS.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# Or, with a hosted TURN service (ExpressTURN, Metered): its fixed username and password.
# TURN_URLS is then the service's turn: / turns: addresses.
TURN_USERNAME=
TURN_CREDENTIAL=
# GIF search proxy (GIPHY).
GIPHY_API_KEY=
# AI assistant and the @flick bot. Tried in this order: Anthropic, Groq (2 accounts), Gemini (2 accounts).
ANTHROPIC_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Web Push (VAPID). Set all three or none; without them notifications are only logged.
# Make a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services, e.g. mailto:ops@example.com
VAPID_SUBJECT=
# TEST ONLY: lets browser and load tests sign in as `Bearer fake:<name>`. The API refuses it in production.
# E2E_FAKE_AUTH=true

# ── 4. Web app (apps/web). Only VITE_* variables reach the browser ─
FRONTEND_PORT=5173
VITE_APP_ENV=development
# API origin for REST and Socket.IO: no trailing slash, no /api.
VITE_API_URL=http://localhost:4000
VITE_CLERK_PUBLISHABLE_KEY=
# Calls between two networks need a TURN relay. STUN alone only works on the same network.
# Free option: ExpressTURN (expressturn.com). Put its username and password below.
VITE_STUN_URLS=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
