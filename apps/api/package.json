{
  "name": "@chat/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API and WebSocket gateway (Fastify 5 modular monolith).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=@chat/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@chat/ai": "*",
    "@chat/contracts": "*",
    "@chat/db": "*",
    "@chat/link-preview": "^0.1.0",
    "@chat/shared": "*",
    "@chat/uploads": "*",
    "@clerk/backend": "^3.26.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.7",
    "livekit-server-sdk": "^2.19.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "socket.io-client": "^4.8.4"
  }
}
