{
  "name": "@chat/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker: scheduled and queued jobs only (pg-boss): notifications, expiring messages, upload cleanup.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=@chat/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@chat/db": "*",
    "@chat/shared": "*",
    "@chat/uploads": "*",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4"
  }
}
